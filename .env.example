# Node.js 24+. Données fictives uniquement.
SESSION_SECRET=
# Mot de passe privé, au moins 12 caractères.
DEMO_CLINICIAN_PASSWORD=
DEMO_GENERALIST_PASSWORD=
DEMO_SPECIALIST_PASSWORD=
APP_ORIGIN=http://127.0.0.1:3001
HACKCURE_CARE_DATABASE_PATH=.data/care.sqlite
HACKCURE_DOCUMENT_DIRECTORY=.data/care-documents
HACKCURE_LIVE_HOST=127.0.0.1
HACKCURE_LIVE_PORT=3001

# Les modèles sont facultatifs et désactivés par défaut.
HACKCURE_AI_PROVIDER=ollama
HACKCURE_LOCAL_AI_ENABLED=false
HACKCURE_OLLAMA_BASE_URL=http://127.0.0.1:11434
HACKCURE_GENERATION_MODEL=gemma4:12b
HACKCURE_EMBEDDING_MODEL=qwen3-embedding:4b

# Pour NVIDIA : choisir explicitement HACKCURE_AI_PROVIDER=nvidia.
NVIDIA_API_KEY=
HACKCURE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Spécialiste MedGemma local facultatif, modèle à installer séparément.
HACKCURE_MEDICAL_SPECIALIST_ENABLED=false
HACKCURE_MEDICAL_SPECIALIST_MODEL=hf.co/unsloth/medgemma-1.5-4b-it-GGUF:Q4_K_M

# Réservé aux comptes fictifs spécifiques déjà configurés.
HACKCURE_DEMO_QUICK_LOGIN_ENABLED=false
